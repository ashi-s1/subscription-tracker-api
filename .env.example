PORT=5500
SERVER_URL="http://localhost:5500"
NODE_ENV=development

# DATABASE
DB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/subscription-tracker?retryWrites=true&w=majority"

# JWT AUTH
JWT_SECRET="your_jwt_secret"
JWT_EXPIRES_IN="1d"

# ARCJET
ARCJET_KEY="your_arcjet_key"
ARCJET_ENV="development"

# UPSTASH QSTASH
QSTASH_URL=http://127.0.0.1:8080
QSTASH_TOKEN=your_token
QSTASH_CURRENT_SIGNING_KEY=your_key
QSTASH_NEXT_SIGNING_KEY=your_key

# NODEMAILER
EMAIL_PASSWORD="your_nodemailer_app_password"
